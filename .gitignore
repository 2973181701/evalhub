# ===== 密钥安全（最高优先级，永远不要提交）=====
config.json
*.key
.env
.env.*
!.env.example
!data/**/config*.json

# ===== 依赖 =====
node_modules/

# ===== MoonBit 构建产物 =====
_build/
*.core
target/
.mooncakes/
.moonagent/

# ===== 前端/后端构建产物 =====
dist/
build/

# ===== 运行期状态（每次标注都会变，不进版本库）=====
data/out/annotations_submitted.json

# ===== 日志与系统垃圾 =====
*.log
.DS_Store
Thumbs.db

# ===== 训练产物（权重与检查点不入库，只保留报告与数据清单）=====
training/out/adapter/
training/out/checkpoints/
training/data/train.jsonl
training/data/rejects.json
*.safetensors
