import {
  "moonbitlang/core/json",
}

options(
  link: {
    "js": {
      "exports": [
        "version",
        "eval_engine",
        "constraint_engine",
        "annotate_engine",
        "analyze_engine",
        "consistency_engine",
        "export_rlhf",
      ],
      "format": "esm",
    },
    "wasm-gc": {
      "exports": [
        "version",
        "eval_engine",
        "constraint_engine",
        "annotate_engine",
        "analyze_engine",
        "consistency_engine",
        "export_rlhf",
        "abi_clear",
        "abi_push",
        "abi_len",
        "abi_read",
        "abi_run",
        "abi_version",
      ],
    },
  },
)
