# EvalHub v2 环境变量模板（复制为 backend/.env，不要提交真实值）
# 不设 DATABASE_URL 时自动回退到 JSON 文件模式

# PostgreSQL（推荐）
DATABASE_URL=postgres://evalhub:evalhub@127.0.0.1:5433/evalhub

# 服务
PORT=3000
HOST=127.0.0.1

# 智谱 GLM（不配置则 /api/eval 与 Judge 不可用，其余接口正常）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 鉴权（默认关闭；设为 1 开启，务必同时设置密钥）
EVALHUB_AUTH=0
EVALHUB_JWT_SECRET=

# 评测队列
EVAL_CONCURRENCY=2

# Judge 提示词版本 / 模式
# JUDGE_PROMPT=v2|v3|v4|v5    默认 v4
# JUDGE_MODE=single|two|hybrid 默认 single
